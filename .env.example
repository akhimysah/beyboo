# Configure real values through the hosting runtime secrets. Never add them to source.
# Required for the voice conversation.
OPENAI_API_KEY=
# Optional overrides.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
SESSION_SIGNING_SECRET=
YOUTUBE_DATA_API_KEY=
# Identity: chatgpt (ChatGPT Sites proxy, default) | access (Cloudflare Access) | password (shared family code) | open (anonymous, quotas only)
AUTH_MODE=chatgpt
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
AUTH_SECRET=
SITE_PASSWORD=
# Public identity sent to MET Norway.
SITE_URL=
CONTACT_EMAIL=
# Spending caps (defaults in lib/quota.mjs).
VOICE_SESSIONS_PER_USER_PER_DAY=24
VOICE_SESSIONS_PER_DAY=240
VOICE_MINUTES_PER_MONTH=600
VOICE_MIN_INTERVAL_SECONDS=8
VIDEO_SEARCHES_PER_USER_PER_DAY=40
VIDEO_SEARCHES_PER_DAY=300
# Security headers: CSP_MODE=report (default) | enforce | off
CSP_MODE=report
